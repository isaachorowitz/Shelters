# Names only. Values are stored in Infisical under /shelters.
# NEXT_PUBLIC values are embedded in browser assets during the build.

# CARTO Basemaps (required for map tiles)
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=your_carto_basemaps_api_key

# Supabase (required for database features)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Only needed if using database write operations (migrations, etc.)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Places API (optional - for fetch-google-places.ts script)
GOOGLE_PLACES_API_KEY=your_google_places_api_key
